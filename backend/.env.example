NODE_ENV=development
PORT=3000
TZ=Europe/London
APP_SHARED_CODE=replace-with-shared-code
# Persistent data directory (mounted disk in production). Leave empty locally.
DATA_DIR=
# Public URL of this backend, used to register the Shopify order webhook.
PUBLIC_BASE_URL=https://your-backend.example.com
MANUAL_ENTRIES_FILE=.manual-entries.json
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_KEY=replace-with-shopify-api-key
SHOPIFY_API_SECRET=replace-with-shopify-api-secret
SHOPIFY_OAUTH_REDIRECT_URI=https://your-backend.example.com/auth/shopify/callback
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_SCOPES=read_orders,read_all_orders
SHOPIFY_TOKEN_FILE=.shopify-token.json
SHOPIFY_MONTH_GOALS_FILE=.shopify-month-goals.json
SHOPIFY_NET_SALES_MODE=subtotal_ex_tax_ship
SHOPIFY_TARGET_GROWTH_PCT=0
NOTION_TOKEN=
NOTION_DB_ID=
NOTION_TITLE_PROPERTY=Name
NOTION_DATE_PROPERTY=Date
NOTION_EVENT_PROPERTY=Event
NOTION_PLACE_PROPERTY=Place
NOTION_TAGS_PROPERTY=Tags
NOTION_TYPE_PROPERTY=Type
NOTION_NOTES_PROPERTY=Notes
NOTION_PEOPLE_EXCLUDE_IDS=
SHOPIFY_HISTORY_MONTHS=12
CACHE_TTL_SECONDS=60
STALE_CACHE_MAX_AGE_SECONDS=3600
# Push notifications (APNs). production must be true for TestFlight/App Store builds.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=com.fitsin.mvp
APNS_PRODUCTION=false
